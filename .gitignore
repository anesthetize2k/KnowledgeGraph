# .gitignore
.env
venv/
.venv/
__pycache__/
*.pyc
# Ignore all files in data except the folder itself
/data/*
!/data/.gitkeep
# Runtime processing logs
processed.json
/archive/
/Wikis/*
!/Wikis/.gitkeep
schema_update_suggestions.json

# Temporary files and scripts
/temp/*
!/temp/.gitkeep